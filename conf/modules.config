/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-hic process configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Per-process ext.args, ext.prefix and publishDir rules.

    Balancing: CLOAD/MERGE always build raw-count coolers. When params.balance is
    true they are written as unpublished "<cool_id>.raw.cool" and feeding the next
    merge, while COOLER_BALANCE and COOLER_ZOOMIFY --balance produce the published,
    balanced .cool/.mcool. When params.balance is false the raw coolers are the
    published products (previous behaviour).
----------------------------------------------------------------------------------------
*/

process {

    // Alignment: 4DN flags (skip mate rescue & pairing, mark secondary, take 5' alignment)
    withName: 'BWAMEM2_MEM' {
        ext.args   = '-SP5M'
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }
    withName: 'BWA_MEM' {
        ext.args   = '-SP5M'
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }

    // Parse: keep SAM columns (needed to emit the deduped BAM) and MAPQ columns
    withName: 'PAIRTOOLS_PARSE' {
        ext.args   = '--add-columns mapq'
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }
    withName: 'PAIRTOOLS_SORT' {
        ext.prefix = { "${meta.library}.run${meta.run}" }
    }
    withName: 'PAIRTOOLS_MERGE' {
        ext.prefix = { "${meta.library}.merged" }
    }
    withName: 'PAIRTOOLS_DEDUP' {
        ext.args   = { "--mark-dups --max-mismatch ${params.max_mismatch}" }
        ext.prefix = { "${meta.library}" }
    }

    // Split: emit deduped BAM + pairs
    withName: 'PAIRTOOLS_SPLIT' {
        ext.args   = { "--output-sam ${meta.library}.bam" }
        ext.prefix = { "${meta.library}" }
        publishDir = [
            path: { "${params.outdir}/bam" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.bam') ? filename : null }
        ]
    }

    // Select: UU/UR/RU always; add MAPQ constraint for the .Q<n> set
    withName: 'PAIRTOOLS_SELECT' {
        ext.args   = {
            def sel = "(pair_type == 'UU') or (pair_type == 'UR') or (pair_type == 'RU')"
            if (meta.mapq > 0) {
                sel = "(${sel}) and (mapq1 >= ${meta.mapq}) and (mapq2 >= ${meta.mapq})"
            }
            sel
        }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/pairs" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.endsWith('.selected.pairs.gz') ? "${meta.cool_id}.pairs.gz" : null }
        ]
    }

    // ------------------------------------------------------------------
    // Per-library contact maps
    // ------------------------------------------------------------------
    withName: '.*:LIBRARY_HIC:COOLER_CLOAD' {
        ext.args   = '--chrom1 2 --pos1 3 --chrom2 4 --pos2 5'
        ext.prefix = { params.balance ? "${meta.cool_id}.raw" : "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/library" },
            mode: params.publish_dir_mode,
            enabled: !params.balance
        ]
    }
    withName: '.*:LIBRARY_HIC:COOLER_BALANCE' {
        ext.args   = { params.balance_args ?: '' }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/library" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:LIBRARY_HIC:COOLER_ZOOMIFY_LIBRARY' {
        ext.args   = {
            def args = "-r ${params.resolutions}"
            if (params.balance) {
                args += ' --balance'
                if (params.balance_args) {
                    args += " --balance-args '${params.balance_args}'"
                }
            }
            args
        }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/library" },
            mode: params.publish_dir_mode
        ]
    }

    // ------------------------------------------------------------------
    // Merged library (tech replicates within a biological replicate)
    // ------------------------------------------------------------------
    withName: '.*:MERGE_LIBRARY:COOLER_MERGE' {
        ext.prefix = { params.balance ? "${meta.cool_id}.raw" : "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/merged_library" },
            mode: params.publish_dir_mode,
            enabled: !params.balance
        ]
    }
    withName: '.*:MERGE_LIBRARY:COOLER_BALANCE' {
        ext.args   = { params.balance_args ?: '' }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/merged_library" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:MERGE_LIBRARY:COOLER_ZOOMIFY' {
        ext.args   = {
            def args = "-r ${params.resolutions}"
            if (params.balance) {
                args += ' --balance'
                if (params.balance_args) {
                    args += " --balance-args '${params.balance_args}'"
                }
            }
            args
        }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/merged_library" },
            mode: params.publish_dir_mode
        ]
    }

    // ------------------------------------------------------------------
    // Merged replicate (biological replicates of a sample)
    // ------------------------------------------------------------------
    withName: '.*:MERGE_REPLICATE:COOLER_MERGE' {
        ext.prefix = { params.balance ? "${meta.cool_id}.raw" : "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/merged_replicate" },
            mode: params.publish_dir_mode,
            enabled: !params.balance
        ]
    }
    withName: '.*:MERGE_REPLICATE:COOLER_BALANCE' {
        ext.args   = { params.balance_args ?: '' }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/merged_replicate" },
            mode: params.publish_dir_mode
        ]
    }
    withName: '.*:MERGE_REPLICATE:COOLER_ZOOMIFY' {
        ext.args   = {
            def args = "-r ${params.resolutions}"
            if (params.balance) {
                args += ' --balance'
                if (params.balance_args) {
                    args += " --balance-args '${params.balance_args}'"
                }
            }
            args
        }
        ext.prefix = { "${meta.cool_id}" }
        publishDir = [
            path: { "${params.outdir}/cool/merged_replicate" },
            mode: params.publish_dir_mode
        ]
    }
}
