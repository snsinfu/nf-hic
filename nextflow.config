/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    nf-hic Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

params {
    // Input options
    input = null
    fasta = null
    gtf = null             // gene-annotation GTF; the catalog 'gtf' is used when --genome is set
    bwa_index = null       // precomputed BWA index directory (used with --aligner bwa)
    bwamem2_index = null   // precomputed bwa-mem2 index directory (used with --aligner bwa-mem2)
    bwamem3_index = null   // precomputed bwa-mem3 index directory (used with --aligner bwa-mem3)
    chrom_sizes = null
    aligner = 'bwa'

    // References
    genome = null
    igenomes_base = 's3://ngi-igenomes/igenomes/'
    igenomes_ignore = false

    // Hi-C options
    bin_size = 1000
    min_mapq = null  // comma-separated MAPQ thresholds, e.g. '0,30'; adds *.Q<n> products
    balance = true
    balance_args = ''
    resolutions = null  // default: "${bin_size}N" (cooler 'nice' progression, e.g. 1000N->1000,2000,5000,...); resolved in conf/modules.config
    max_mismatch = 1

    // Output options
    save_bam = false             // write and publish the deduplicated BAM (large)
    save_pairs = false           // publish the .pairs files
    save_library = false         // publish per-library contact maps + stats
    skip_pairtools_stats = false // skip pairtools stats
    merge_pairs = false          // also merge pairs across tech/bio replicates (expensive)

    // Analysis options
    skip_calder2 = false         // skip CALDER2 compartments + nested sub-domains
    calder2_resolution = 100000  // .mcool resolution for CALDER2; must exist in --resolutions
    calder2_genome = null        // CALDER reference genome; unset falls back to --genome
    calder2_feature_track = null // 4-col bed (chr,start,end,score) for A/B phasing on non-built-in genomes
    calder2_args = ''            // extra CALDER2 flags, e.g. '--adaptive'

    // OnTAD hierarchical TAD calling (opt-out; requires --balance)
    skip_ontad = false           // skip OnTAD TAD calling
    ontad_resolution = 10000     // .mcool resolution for OnTAD; must exist in --resolutions
    ontad_minsz = 3              // minimum TAD size in bins
    ontad_maxsz = 200            // maximum TAD size in bins; scale with the resolution
    ontad_lsize = 5              // local-minimum window half-size in bins
    ontad_ldiff = 1.96           // local-minimum threshold in stddevs
    ontad_penalty = 0.1          // penalty applied to the OnTAD score
    ontad_diagonal = null        // matrix band half-width; null = 2 * ontad_maxsz
    ontad_nan_mode = 'expected'  // NaN fill: 'expected' (P(s) expectation) or 'zero'
    ontad_no_balance = false     // dump raw counts instead of balanced values
    ontad_args = ''              // extra OnTAD flags, e.g. '-log2'

    // Standalone sub-pipeline (ontad.nf) input; not used by main.nf
    ontad_mcool = null           // balanced .mcool path/glob or comma-separated list

    // Boilerplate options
    outdir = 'results'
    publish_dir_mode = 'copy'
    monochrome_logs = false
}

process.shell = [
    'bash',
    '-C',       // No clobber
    '-e',       // Exit on non-zero
    '-u',       // Error on unset variables
    '-o',       // Set pipefail
    'pipefail',
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

includeConfig 'conf/base.config'

// Load igenomes.config unless ignored
includeConfig !params.igenomes_ignore ? 'conf/igenomes.config' : 'conf/igenomes_ignored.config'

profiles {
    debug {
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled = true
    }
    mamba {
        conda.enabled = true
        conda.useMamba = true
    }
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    apptainer {
        apptainer.enabled = true
        apptainer.autoMounts = true
    }
}

manifest {
    name = 'nf-hic'
    description = 'Minimal 4DN-style Hi-C pipeline (bwa/bwa-mem2/bwa-mem3 + pairtools + cooler)'
    mainScript = 'main.nf'
    nextflowVersion = '!>=25.10.0'
    version = '0.1.0'
}

plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes", "igenomes_base"]
}

includeConfig 'conf/modules.config'
