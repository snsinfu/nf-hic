/*
 * Standalone config for subpipeline/ontad.nf.
 *
 * Mirrors the OnTAD parameters and process arguments of the main nf-hic
 * pipeline (nextflow.config + conf/modules.config) so the same flags work,
 * but publishes the assembled TSVs flat into --outdir instead of the
 * <aligner>/<level>/ontad/ tree.
 *
 * Process labels/resources come from conf/base.config.
 */

params {
    // Inputs
    mcool       = null   // balanced .mcool path/glob or comma-separated list
    chrom_sizes = null   // chrom.sizes matching the coolers

    // OnTAD (same names/defaults as the main pipeline)
    ontad_resolution = 10000
    ontad_minsz      = 3
    ontad_maxsz      = 200
    ontad_lsize      = 5
    ontad_ldiff      = 1.96
    ontad_penalty    = 0.1
    ontad_diagonal   = null      // null -> 2 * ontad_maxsz
    ontad_nan_mode   = 'expected'
    ontad_no_balance = false
    ontad_args       = ''

    // Output
    outdir           = 'ontad_results'
    publish_dir_mode = 'copy'
}

includeConfig '../conf/base.config'

process {
    // Unqualified selectors match the simple process name inside ONTAD_HIC.
    withName: 'ONTAD_DUMP_MATRIX' {
        ext.args = {
            def diagonal = params.ontad_diagonal ?: ((params.ontad_maxsz as int) * 2)
            def args = "--diagonal ${diagonal} --nan-mode ${params.ontad_nan_mode}"
            if (params.ontad_no_balance) args += ' --no-balance'
            args
        }
    }
    withName: 'ONTAD' {
        ext.args = {
            def args = "-minsz ${params.ontad_minsz} -maxsz ${params.ontad_maxsz} -lsize ${params.ontad_lsize} -ldiff ${params.ontad_ldiff} -penalty ${params.ontad_penalty}"
            if (params.ontad_args) args += " ${params.ontad_args}"
            args
        }
    }
    withName: '.*:ONTAD_ASSEMBLE' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode
        ]
    }
}
